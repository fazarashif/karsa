{
  "$meta": { "name": "Karsa design tokens", "version": "1.0.0", "units": "logical px at 100% scaling", "css": "tokens.css" },
  "color": {
    "palette": {
      "kuningan": "#D4A84B", "kuningan-hover": "#DDB662", "kuningan-pressed": "#C29640",
      "sogan": "#C08552", "sogan-deep": "#8A5A2E", "bata": "#D9644A", "gading": "#EFE6D2",
      "daun": "#A8B46A", "abang": "#F07A6A", "iris": "#3B2414"
    },
    "island-bg": "#000000",
    "fg": "#F5F5F7",
    "muted": "#EBEBF58F",
    "faint": "#EBEBF580",
    "disabled": "#EBEBF552",
    "hairline": "#FFFFFF17",
    "hairline-strong": "#FFFFFF29",
    "surface": "#FFFFFF12",
    "surface-hover": "#FFFFFF1F",
    "surface-pressed": "#FFFFFF29",
    "track": "#FFFFFF1F",
    "popover-bg": "#141414",
    "checkbox-border": "#EBEBF580",
    "focus-ring": "#EFE6D2B3",
    "accent": "#D4A84B", "accent-hover": "#DDB662", "accent-pressed": "#C29640", "on-accent": "#000000",
    "focus": "#D4A84B", "meeting": "#C08552", "deadline": "#D9644A", "general": "#EFE6D2",
    "done": "#A8B46A", "danger": "#F07A6A", "ornament": "#8A5A2E",
    "focus-tint": "#D4A84B29", "meeting-tint": "#C0855229", "deadline-tint": "#D9644A29",
    "general-tint": "#EFE6D21F", "done-tint": "#A8B46A29", "danger-tint": "#F07A6A29",
    "eye-sclera": "#EFE6D2", "eye-iris": "#3B2414", "eye-glint": "#FFFFFF", "eye-blush": "#D9644A8C"
  },
  "contrastOnBlack": {
    "fg": 19.3, "muted": 5.6, "faint": 4.6, "kuningan": 9.5, "sogan": 6.7, "bata": 5.9,
    "gading": 16.9, "daun": 9.4, "abang": 7.7, "note": "disabled and sogan-deep are not used for text"
  },
  "shadow": {
    "edge": "inset 0 0 0 1px #FFFFFF12",
    "edge-notch": "inset 1px 0 0 #FFFFFF12, inset -1px 0 0 #FFFFFF12, inset 0 -1px 0 #FFFFFF12"
  },
  "font": {
    "text": "'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif",
    "display": "'Segoe UI Variable Display', 'Segoe UI', system-ui, sans-serif",
    "weight": { "regular": 400, "semibold": 600 }
  },
  "type": {
    "caption":  { "size": 11, "lineHeight": 14, "weight": 600, "tracking": "0.06em", "transform": "uppercase", "use": "row keys, section headers" },
    "meta":     { "size": 11, "lineHeight": 14, "weight": 400, "use": "due dates, counts, hints" },
    "greeting": { "size": 11, "lineHeight": 14, "weight": 600, "tracking": "0.02em", "use": "panel greeting" },
    "body":     { "size": 13, "lineHeight": 18, "weight": 400 },
    "body-strong": { "size": 13, "lineHeight": 18, "weight": 600, "use": "pill, tabs, buttons" },
    "editor":   { "size": 13, "lineHeight": 20, "weight": 400 },
    "peek-date": { "size": 14, "lineHeight": 18, "weight": 600 },
    "title":    { "size": 15, "lineHeight": 20, "weight": 600, "use": "alert title, note title, proverb" },
    "title-lg": { "size": 17, "lineHeight": 22, "weight": 600, "use": "panel date" },
    "timer":    { "size": 56, "lineHeight": 60, "weight": 600, "family": "display", "tracking": "-0.01em", "numeric": "tabular-nums" }
  },
  "space": { "0-5": 2, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32 },
  "radius": {
    "checkbox": 4, "icon-button": 8, "badge": 9, "control": 10, "menu": 12,
    "button": 14, "pill": 16, "card": 22, "panel": 26
  },
  "size": {
    "window": [400, 540], "pill-h": 32, "pill-min-w": 72, "pill-max-w": 220,
    "notch-h": 26, "notch-min-w": 80, "notch-max-w": 200, "notch-radius": 12,
    "peek": [320, 172], "panel": [380, 520], "alert": [320, 112],
    "control-h": 36, "button-h": 28, "icon-button": 28, "tab-h": 32, "icon": 16,
    "kawung": 10, "eyes": [28, 14]
  },
  "opacity": { "disabled": 0.32, "watermark": 0.06 },
  "motion": {
    "spring": "linear(0, 0.015, 0.0544, 0.1111, 0.1792, 0.254, 0.3317, 0.4093, 0.4847, 0.5562, 0.6228, 0.6838, 0.7387, 0.7876, 0.8305, 0.8677, 0.8995, 0.9263, 0.9486, 0.9669, 0.9817, 0.9933, 1.0022, 1.0089, 1.0137, 1.0169, 1.0188, 1.0198, 1.0199, 1.0194, 1.0185, 1.0173, 1.0159, 1.0144, 1.0128, 1.0113, 1.0098, 1.0084, 1.0071, 1.0059, 1.0049, 1.0039, 1.0031, 1.0024, 1)",
    "easeOut": "cubic-bezier(0.22, 1, 0.36, 1)",
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "duration": {
      "morph": 700, "radius": 350, "fast": 120, "base": 160, "contentIn": 220, "contentOut": 100,
      "contentInDelay": 90, "beat": 60, "beatMax": 5, "blink": 140, "gong": 240, "tab": 160
    },
    "reducedMotion": "all durations 0"
  },
  "timing": { "hoverOpen": 300, "hoverClose": 400, "alertHold": 8000, "regionSettle": 450, "snooze": 300000, "nightStart": "22:00", "nightEnd": "05:00" }
}
